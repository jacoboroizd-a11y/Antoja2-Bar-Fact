DATABASE_URL="postgresql://mariaraul:CHANGE_ME@localhost:5432/mariaraul?schema=public"
# Local Docker only: must match the password in DATABASE_URL
POSTGRES_PASSWORD="CHANGE_ME"
AUTH_SECRET="generate-with-openssl-rand-hex-32"
APP_URL="http://localhost:3000"
# Required ONLY when running the demo seed (minimum 12 characters)
SEED_ADMIN_PASSWORD=""
SEED_BILLING_PASSWORD=""

# Optional integrations. Set real values securely in Vercel; never commit them.
# Verified Resend sender, e.g. Dra. Mariaraul <reportes@your-verified-domain>
RESEND_API_KEY=""
REPORTS_FROM=""
# Protects /api/cron/clinic. Vercel sends it automatically in Authorization.
CRON_SECRET=""
# Google OAuth: authorize APP_URL/api/calendar/google/callback in Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Meta webhook signature verification; tokens/account IDs entered in Administration.
META_APP_SECRET=""
META_GRAPH_VERSION="v24.0"
